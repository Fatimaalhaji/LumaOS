DATABASE_URL=postgres://postgres:postgres@localhost:5432/lumaos
AUTH_SECRET=replace-with-a-strong-random-secret
AUTH_TRUST_HOST=true

# Server-only Intelligence Engine configuration. Never prefix these with NEXT_PUBLIC_.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_OUTPUT_TOKENS=700
AI_TEMPERATURE=0.4
